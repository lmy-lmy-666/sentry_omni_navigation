<?xml version="1.0"?>
<package format="3">
  <name>omni_decision_sample</name>
  <version>0.1.0</version>
  <description>Simplified sentry navigation decision: PATROL when healthy, RESUPPLY (drive home, never give up) when hp/ammo low.</description>
  <maintainer email="boombroke@example.com">Boombroke</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rm_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>yaml-cpp</depend>

  <!-- python helper scripts: mock_referee.py / preflight_check.py -->
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
